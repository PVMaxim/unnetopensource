{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",

    /* Strict Type-Checking */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    /* JS interop — allow .js files to coexist while migrating */
    "allowJs": true,
    "checkJs": false,

    /* Emit */
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    /* Resolution */
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,

    /* Path aliases (must match vite.config.js resolve.alias) */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/node_modules",
    "src/api/pkg"
  ],
  "references": [
    { "path": "./tsconfig.node.json" }
  ]
}
