# ==============================================================================
# United Wallet - Open Source Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Web3 & Wallet Integrations
# ------------------------------------------------------------------------------
# WalletConnect Cloud Project ID (get yours at https://cloud.walletconnect.com)
UNITED_CONNECT_PROJECT_ID=

# ------------------------------------------------------------------------------
# External Services & Swap Aggregators (Optional Overrides)
# All services default to public endpoints out of the box.
# ------------------------------------------------------------------------------
# VITE_COINGECKO_API_URL=https://api.coingecko.com
# VITE_1INCH_API_URL=https://api.1inch.dev
# VITE_CHANGELLY_API_URL=https://api.changelly.com/v2
# VITE_BRIDGERS_API_URL=https://api.bridgers.xyz/api
# VITE_TON_API_URL=https://tonapi.io/v2
# VITE_OMNIBRIDGE_API_URL=https://www.swftc.info/api
# VITE_THIRD_PARTY_PROXY_URL=
# VITE_TOKEN_ICONS_CDN_URL=
# VITE_WEBVIEW_UA=

# ------------------------------------------------------------------------------
# Blockchain RPC Endpoints (Optional Overrides)
# If not specified, standard public RPCs defined in manifests are used.
# ------------------------------------------------------------------------------
# VITE_RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
# VITE_RPC_BINANCE=https://bsc-dataseed.binance.org
# VITE_RPC_SOLANA=https://api.mainnet-beta.solana.com
# VITE_RPC_SOLANA_WS=wss://api.mainnet-beta.solana.com
# VITE_RPC_POLYGON=https://polygon-bor-rpc.publicnode.com
# VITE_RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
# VITE_RPC_BASE=https://mainnet.base.org
# VITE_RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
# VITE_RPC_TRON=https://api.trongrid.io
# VITE_RPC_TON=https://toncenter.com/
# VITE_RPC_BITCOIN=https://mempool.space
# VITE_RPC_KATANA=https://rpc.katana.network
# VITE_RPC_COTI=https://mainnet.coti.io/rpc
# VITE_RPC_VENOM=https://jrpc.venom.foundation/rpc
# VITE_RPC_XRPL=wss://xrplcluster.com/

# ------------------------------------------------------------------------------
# Blockchain Scanner APIs (Optional Overrides)
# ------------------------------------------------------------------------------
# VITE_SCANNER_ETHEREUM=https://api.etherscan.io/v2/api?chainid=1
# VITE_SCANNER_BINANCE=https://api.etherscan.io/v2/api?chainid=56
# VITE_SCANNER_POLYGON=https://api.etherscan.io/v2/api?chainid=137
# VITE_SCANNER_ARBITRUM=https://api.etherscan.io/v2/api?chainid=42161
# VITE_SCANNER_BASE=https://api.etherscan.io/v2/api?chainid=8453
# VITE_SCANNER_AVALANCHE=https://api.etherscan.io/v2/api?chainid=43114
# VITE_SCANNER_KATANA=https://api.etherscan.io/v2/api?chainid=747474
# VITE_SCANNER_COTI=https://mainnet.cotiscan.io/api
# VITE_SCANNER_SOLANA=https://public-api.solscan.io/
# VITE_SCANNER_TRON=https://apilist.tronscanapi.com

# ------------------------------------------------------------------------------
# Legacy Storage Migration (AES-CBC)
# Only required if migrating legacy localStorage data from older wallet versions.
# All new data is securely encrypted directly in IndexedDB using non-extractable keys.
# ------------------------------------------------------------------------------
UNITED_CARDS_KEY=example-dev-card-encryption-key-change-in-production
UNITED_CARDS_IV_KEY=example-iv-fallback-32-chars-long!
