# ==============================================================================
# Environment Configuration
# ==============================================================================

# Application Environment Mode: 'development' | 'production' | 'staging'
ENVIRONMENT_NAME=development

# ------------------------------------------------------------------------------
# Local Storage Encryption (AES-CBC)
# Keys used to securely encrypt and decrypt card data in the browser's local storage.
# ------------------------------------------------------------------------------
# Master secret used for PBKDF2 key derivation (minimum recommended: 32 random chars)
UNITED_CARDS_KEY=example-dev-card-encryption-key-change-in-production

# Fallback Initialization Vector string (used for legacy decryption fallback)
UNITED_CARDS_IV_KEY=example-iv-fallback-32-chars-long!

# ------------------------------------------------------------------------------
# Web3 & Wallet Integrations
# ------------------------------------------------------------------------------
# WalletConnect Cloud Project ID (get yours at https://cloud.walletconnect.com)
UNITED_CONNECT_PROJECT_ID=

# Optional custom WalletConnect relay / proxy URL
# VITE_WALLET_CONNECT_URL=

# ------------------------------------------------------------------------------
# Backend Workers (Optional)
# ------------------------------------------------------------------------------
# Shared secret for authenticating requests with custom RPC proxy workers
WORKER_SHARED_SECRET=
